# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# Meta Model API key, from the dashboard at https://dev.meta.ai/
MODEL_API_KEY=

# Defaults shown; override only if Meta changes them.
META_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Muse Spark Open via Baseten (open-weights mode, day 6)
# BASETEN_API_KEY=
# MUSE_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# Which model answers /api/v1/ask: meta | baseten | offline.
# Default: meta when MODEL_API_KEY is set, otherwise offline (rule-based, no model; for dev and tests).
# LUMINA_PROVIDER=meta

# Database. Leave unset to use the built-in PGlite + PostGIS with labelled demo data.
# Azure Database for PostgreSQL (see docs/deploy-azure.md):
#   DATABASE_URL      admin connection string, for `npm run db:setup` and local development
#   DATABASE_URL_RO   the read-only lumina_agent login; deployed apps get only this one
#   AGENT_DB_PASSWORD password db:setup gives lumina_agent (--agent-login)
# DATABASE_URL=postgres://luminaadmin:<password>@<server>.postgres.database.azure.com:5432/lumina?sslmode=require
# DATABASE_URL_RO=postgres://lumina_agent:<password>@<server>.postgres.database.azure.com:5432/lumina?sslmode=require
# AGENT_DB_PASSWORD=

# Per-IP limit for /api/v1/ask (requests per minute).
# RATE_LIMIT_PER_MIN=20
# CORS for the Quest web app and other clients (default *).
# CORS_ALLOW_ORIGIN=*

# Eval cost (USD per million tokens), from the Meta pricing page.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=

# Sign-in (required for the portal and API). AUTH_SECRET: 32+ random characters.
AUTH_SECRET=
# Microsoft Entra ID app registration (any work or personal account). Redirect URI:
#   http://localhost:3000/api/auth/callback/microsoft  and  https://<your-app>/api/auth/callback/microsoft
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_TENANT=common
# AUTH_URL=https://<your-app>            # public origin, if not detected from proxy headers
# AUTH_DEMO_DISABLED=1                    # hide "Continue as judge (demo)"
# LUMINA_API_KEYS=<key1>,<key2>           # 24+ char keys for machine clients (Quest app)
