{
  "name": "lumina-precinct-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "spike:mock": "tsx spikes/mock-meta-server.ts",
    "spike:spark": "tsx spikes/01-muse-spark-tools.ts",
    "spike:chips": "tsx spikes/fetch-nsw-chips.ts",
    "spike:sam": "tsx spikes/02-sam-landuse.ts",
    "spike:voice": "tsx spikes/03-voice-transcribe.ts",
    "test": "vitest run",
    "eval": "tsx --tsconfig tsconfig.json scripts/eval.ts",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "db:setup": "tsx --tsconfig tsconfig.json scripts/db-setup.ts",
    "package:azure": "node scripts/package-standalone.mjs",
    "ingest:vg": "tsx --tsconfig tsconfig.json scripts/ingest/vg.ts",
    "ingest:gnaf-sample": "tsx --tsconfig tsconfig.json scripts/ingest/gnaf-sample.ts",
    "ingest:gnaf": "node --max-old-space-size=8192 --import tsx scripts/ingest/gnaf.ts",
    "ingest:geocode": "node --max-old-space-size=8192 --import tsx scripts/ingest/geocode.ts",
    "ingest:sales": "npm run ingest:vg && npm run ingest:gnaf && npm run ingest:geocode",
    "ingest:patronage": "tsx --tsconfig tsconfig.json scripts/ingest/patronage.ts",
    "ingest:gtfs": "npm run ingest:gtfs-lines",
    "ingest:gtfs-lines": "tsx --tsconfig tsconfig.json scripts/ingest/gtfs-lines.ts",
    "ingest:boundaries": "tsx --tsconfig tsconfig.json scripts/ingest/abs-boundaries.ts",
    "fetch:landuse": "tsx --tsconfig tsconfig.json scripts/fetch/landuse.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-postgis": "^0.2.12",
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/openai": "^1.7.1",
    "@meta-sam/parser": "^0.1.0",
    "fflate": "^0.8.2",
    "jose": "^6.2.14",
    "libpg-query": "^18.2.1",
    "maplibre-gl": "6.15",
    "next": "16.4.3",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Lumina Precinct Agent (Dronovation Labs): headless agentic BI for Sydney station precincts on Meta Muse models.",
  "engines": {
    "node": ">=22.9.0"
  }
}
